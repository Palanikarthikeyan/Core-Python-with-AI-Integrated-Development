>>> L = []
>>> for var in [10,20,30,40,50]:
...     r = var + 100
...     L.append(r)
...
>>> L
[110, 120, 130, 140, 150]
>>>
>>> # [final value for iterable]
>>> #              -----(1)----
>>> #  --(2)---
>>>
>>>
>>> [var+100 for var in [10,20,30,40,50]]
[110, 120, 130, 140, 150]
>>>

>>> [var+100 for var in [10,20,30,40,50] if var >30]
[140, 150]
>>>
>>> L = []
>>> for var in [10,20,30,40,50]:
...     if(var > 30):
...         r = var + 100
...         L.append(r)
...     else:
...         r = var + 500
...         L.append(r)
...
>>> L
[510, 520, 530, 140, 150]
>>>
>>> [var+100 if var >30 else var+500 for var in [10,20,30,40,50]]
[510, 520, 530, 140, 150]
>>>

>>> {var: var+100 for var in [10,20,30,40,50]}
{10: 110, 20: 120, 30: 130, 40: 140, 50: 150}
>>>
